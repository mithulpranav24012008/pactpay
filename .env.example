# PayPal Sandbox App (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Claude (the agent that drafts contracts and explains verification)
ANTHROPIC_API_KEY=

# Optional: raises GitHub API rate limits for CI checks
GITHUB_TOKEN=

# Where the server is reachable (used for PayPal return/cancel URLs)
PUBLIC_URL=http://localhost:4000
WEB_URL=http://localhost:5173
PORT=4000
